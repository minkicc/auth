# Copy this file to .env before starting a MySQL/MinIO quickstart.
# Replace every value marked CHANGE_ME with a unique random value.

MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
MYSQL_PASSWORD=CHANGE_ME_mysql_user

MINIO_ROOT_USER=auth-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root
MINIO_ATTACH_ACCESS_KEY=auth-attach
MINIO_ATTACH_SECRET_KEY=CHANGE_ME_minio_attach
MINIO_STS_ACCESS_KEY=auth-sts
MINIO_STS_SECRET_KEY=CHANGE_ME_minio_sts

# Optional. The default is suitable only for local evaluation.
# AUTH_PUBLIC_URL=http://127.0.0.1:8080
# Optional. Required only when enabling the demo-backend client manually.
# AUTH_DEMO_BACKEND_SECRET=CHANGE_ME_demo_backend
# Optional release image override.
# AUTH_IMAGE=ghcr.io/example/auth:v1.2.3
